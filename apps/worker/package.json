{
  "name": "@link-checker/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "start:scheduler": "dotenv -e ../../.env -- node dist/scheduler.js",
    "dev": "dotenv -e ../../.env -- node --watch -r @swc-node/register src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "smoke:firecrawl": "dotenv -e ../../.env -- node -r @swc-node/register src/scripts/smoke-firecrawl.ts",
    "smoke:firecrawl:enhanced": "dotenv -e ../../.env -- node -r @swc-node/register src/scripts/smoke-firecrawl-enhanced.ts",
    "debug:robots": "dotenv -e ../../.env -- node -r @swc-node/register src/scripts/debug-meta-robots.ts"
  },
  "dependencies": {
    "@link-checker/crawler-core": "workspace:*",
    "@link-checker/db": "workspace:*",
    "@link-checker/shared": "workspace:*",
    "@link-checker/worker-core": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/testing": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.20.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.35",
    "@types/node": "^20.16.11",
    "dotenv-cli": "^7.4.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.2"
  }
}
