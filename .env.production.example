# ============================================
# Production .env — link-check-pro.top
# ============================================
# Copy this file to `.env` on the server (NOT committed to git).
# Generate secrets locally and paste them here.
#
# IMPORTANT — escape `$` in bcrypt hashes as `\$` (dotenv expansion eats them):
#   ADMIN_PASSWORD_HASH=\$2a\$12\$WcoSIev...
# ============================================

# ─── Public URLs (HTTPS, no trailing slash) ─────────────────────────
PUBLIC_WEB_URL=https://link-check-pro.top
PUBLIC_API_URL=https://api.link-check-pro.top
NEXT_PUBLIC_API_URL=https://api.link-check-pro.top

# ─── Auth (super admin) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@link-check-pro.top
# Generate locally: node -e "console.log(require('bcryptjs').hashSync('your_password', 12))"
# Then escape every $ as \$
ADMIN_PASSWORD_HASH=
# Generate: openssl rand -base64 32
AUTH_SECRET=

# ─── Postgres ───────────────────────────────────────────────────────
POSTGRES_USER=linkchecker
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=linkchecker
# DATABASE_URL is composed inside docker-compose.prod.yml — no need to set here
# unless you run prisma CLI from the host. If you do, point it at localhost:5432
# (assuming you publish the postgres port temporarily).

# ─── Redis ──────────────────────────────────────────────────────────
# Same: REDIS_URL is composed by compose. Internal-only, no auth needed.

# ─── Firecrawl ──────────────────────────────────────────────────────
FIRECRAWL_API_KEY=
FIRECRAWL_CONCURRENCY=45

# ─── Google Sheets (single service account) ────────────────────────
# The JSON file lives at ./secrets/service-account.json on the host
# and is mounted into worker containers as /secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_PATH=/secrets/service-account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# ─── Limits ─────────────────────────────────────────────────────────
MAX_MANUAL_URLS_PER_TASK=1000
SINGLE_LINK_RECHECK_COOLDOWN_SEC=60
PER_DOMAIN_RPS=2
WORKER_CONCURRENCY=5

# ─── Observability (optional) ───────────────────────────────────────
SENTRY_DSN=

# ─── Deploy / image source ──────────────────────────────────────────
# GitHub username/org that owns the GHCR images
GHCR_OWNER=
# Image tag to deploy. CI sets this to git sha; you can pin manually for rollback.
IMAGE_TAG=latest
