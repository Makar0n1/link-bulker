# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Web image — Next.js 15 with `output: 'standalone'`
#
# Notes:
#   - We DO NOT use `turbo prune` here. The combination of pnpm workspaces +
#     Next.js webpack module resolution + pruned monorepo is fragile: webpack
#     fails to resolve `@link-checker/shared` even though pnpm install creates
#     the symlink. Skipping prune costs us a few seconds of upload (the build
#     context is small thanks to .dockerignore) but is bulletproof.
#   - NEXT_PUBLIC_API_URL must be baked at BUILD time (Next inlines it into
#     the client bundle). Pass via --build-arg.
#   - Standalone output produces a self-contained server.js that needs only
#     `.next/static` and (optionally) `public/` next to it.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat tini wget \
    && corepack enable \
    && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
ENV CI=true

# ─── Builder ─────────────────────────────────────────────────────────────────
FROM base AS builder

# Copy everything (filtered by .dockerignore — no node_modules, no .env, etc.)
COPY . .

# Force pnpm to use a hoisted node_modules layout (npm-style flat tree)
# instead of the default symlink farm. This is the only reliable way to
# make Next.js webpack resolve `@link-checker/shared` from a workspace
# inside a Docker build — symlinks across pruned/copied trees are flaky.
RUN echo "node-linker=hoisted" > .npmrc \
    && echo "shamefully-hoist=true" >> .npmrc \
    && echo "public-hoist-pattern[]=*" >> .npmrc

# Install all workspace deps. With hoisted linker, workspace packages are
# materialised as real directories inside node_modules.
RUN pnpm install --no-frozen-lockfile

# Build the workspace dep first so its dist/ exists before Next tries to
# resolve @link-checker/shared from node_modules.
RUN pnpm --filter @link-checker/shared build

# Public URL of the API — baked into the client bundle.
ARG NEXT_PUBLIC_API_URL=https://api.link-check-pro.top
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1

# Build web. shared/dist already exists from the step above, so Next can
# resolve @link-checker/shared as a regular package.
RUN pnpm --filter @link-checker/web build

# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
RUN apk add --no-cache tini wget
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Standalone output already contains a minimal node_modules tree with the
# transitive deps Next needs at runtime. We copy only what `output: standalone`
# emits — final image stays small (~150 MB).
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

# Non-root
RUN addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs lc \
    && chown -R lc:nodejs /app
USER lc

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3000/ || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
