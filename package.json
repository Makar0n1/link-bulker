{
  "name": "link-checker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:all": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @link-checker/db run generate",
    "db:migrate": "pnpm --filter @link-checker/db run migrate",
    "db:studio": "pnpm --filter @link-checker/db run studio",
    "db:seed": "pnpm --filter @link-checker/db run seed",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "eslint": "^9.12.0",
    "@types/node": "^20.16.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
