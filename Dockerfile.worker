# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Worker image — NestJS standalone + BullMQ consumers + Firecrawl + Sheets
# Identical multi-stage strategy as Dockerfile.api but targets the worker.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini \
    && corepack enable \
    && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
ENV CI=true

# ─── Pruner ──────────────────────────────────────────────────────────────────
FROM base AS pruner
RUN npm install -g turbo@2.1.3
COPY . .
RUN turbo prune @link-checker/worker --docker

# ─── Builder ─────────────────────────────────────────────────────────────────
FROM base AS builder
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ ./

RUN cd packages/db && pnpm exec prisma generate

RUN pnpm turbo run build --filter=@link-checker/worker

# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production

COPY --from=builder /app /app

# Non-root user
RUN addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs lc \
    && chown -R lc:nodejs /app
USER lc

# Worker has no HTTP port — health is liveness via process presence.
# Compose-level healthcheck pings Redis from inside the container instead.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "const r=require('ioredis');const c=new r(process.env.REDIS_URL);c.ping().then(()=>process.exit(0)).catch(()=>process.exit(1))" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/worker/dist/main.js"]
