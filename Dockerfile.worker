# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# Worker image — NestJS standalone + BullMQ consumers + Firecrawl + Sheets
#
# Same strategy as Dockerfile.api: skip turbo prune, use hoisted pnpm
# node_modules so all workspace deps and Prisma client are reachable at
# both compile-time and runtime.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini \
    && corepack enable \
    && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
ENV CI=true

# ─── Builder ─────────────────────────────────────────────────────────────────
FROM base AS builder

COPY . .

RUN echo "node-linker=hoisted" > .npmrc \
    && echo "shamefully-hoist=true" >> .npmrc \
    && echo "public-hoist-pattern[]=*" >> .npmrc

RUN pnpm install --no-frozen-lockfile

RUN cd packages/db && pnpm exec prisma generate

RUN pnpm --filter @link-checker/shared build \
    && pnpm --filter @link-checker/db build \
    && pnpm --filter @link-checker/crawler-core build \
    && pnpm --filter @link-checker/worker-core build \
    && pnpm --filter @link-checker/worker build

# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production

COPY --from=builder /app /app

# Non-root user
RUN addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs lc \
    && chown -R lc:nodejs /app
USER lc

# Worker has no HTTP port — health is liveness via Redis ping
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "const r=require('ioredis');const c=new r(process.env.REDIS_URL);c.ping().then(()=>process.exit(0)).catch(()=>process.exit(1))" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/worker/dist/main.js"]
