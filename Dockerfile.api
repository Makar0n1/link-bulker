# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
# API image — NestJS + Fastify on Node 20
#
# Strategy:
#   - Skip `turbo prune`. The combination of pnpm + workspace deps in a pruned
#     monorepo is fragile (workspace symlinks don't survive the prune cleanly,
#     so types from `@link-checker/db` etc. resolve to `any` and the build
#     dies with hundreds of TS errors).
#   - Use pnpm's "hoisted" node_modules linker so workspace packages are
#     materialised as real directories, exactly like npm/yarn.
#   - Build all workspace deps first, then api itself, then copy everything
#     into a non-root runtime stage.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini wget \
    && corepack enable \
    && corepack prepare pnpm@9.12.0 --activate
WORKDIR /app
ENV CI=true

# ─── Builder ─────────────────────────────────────────────────────────────────
FROM base AS builder

# Copy everything (filtered by .dockerignore)
COPY . .

# Force hoisted (npm-style) node_modules so all workspace deps are real dirs.
RUN echo "node-linker=hoisted" > .npmrc \
    && echo "shamefully-hoist=true" >> .npmrc \
    && echo "public-hoist-pattern[]=*" >> .npmrc

RUN pnpm install --no-frozen-lockfile

# Generate Prisma client (no DATABASE_URL needed for generate)
RUN cd packages/db && pnpm exec prisma generate

# Build all workspace deps + api itself in dependency order
RUN pnpm --filter @link-checker/shared build \
    && pnpm --filter @link-checker/db build \
    && pnpm --filter @link-checker/worker-core build \
    && pnpm --filter @link-checker/api build

# ─── Runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0

# Copy entire built workspace. Slightly larger image but bulletproof against
# pnpm workspace symlink resolution issues at runtime.
COPY --from=builder /app /app

# Drop root
RUN addgroup -g 1001 -S nodejs \
    && adduser -S -u 1001 -G nodejs lc \
    && chown -R lc:nodejs /app
USER lc

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3001/api/v1/health || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/api/dist/main.js"]
