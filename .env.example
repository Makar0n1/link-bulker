# ============================================
# Public URLs
# ============================================
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
# Public env exposed to Next.js client bundle
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Auth (super admin)
# ============================================
ADMIN_EMAIL=admin@link-check-pro.top
# Generate via: node -e "console.log(require('bcryptjs').hashSync('your_password', 12))"
ADMIN_PASSWORD_HASH=
# Generate via: openssl rand -base64 32
AUTH_SECRET=

# ============================================
# Postgres
# ============================================
POSTGRES_USER=linkchecker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=linkchecker
DATABASE_URL=postgresql://linkchecker:changeme@localhost:5432/linkchecker

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# Firecrawl
# ============================================
FIRECRAWL_API_KEY=
# Stay below the 50 concurrent limit of the Standard plan
FIRECRAWL_CONCURRENCY=45

# ============================================
# Google Sheets (single service account)
# ============================================
GOOGLE_SERVICE_ACCOUNT_PATH=/secrets/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# ============================================
# Limits
# ============================================
MAX_MANUAL_URLS_PER_TASK=1000
SINGLE_LINK_RECHECK_COOLDOWN_SEC=60
PER_DOMAIN_RPS=2
WORKER_CONCURRENCY=5

# ============================================
# Observability (optional)
# ============================================
SENTRY_DSN=

# ============================================
# Deploy (used by docker-compose in prod)
# ============================================
DOCKERHUB_USERNAME=
IMAGE_TAG=latest
